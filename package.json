{
  "name": "bypass-bot",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/bot/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/bot/index.ts",
    "scan": "ts-node-dev --transpile-only src/tools/scan.ts",
    "webhook:info": "ts-node-dev --transpile-only src/tools/webhookInfo.ts",
    "postinstall": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.30.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
